#!/bin/sh
# WynlandOS - test-wyn: run a numbered test from the developer's machine.
#
#   test-wyn        the list of tests
#   test-wyn N [ARGS]  test N (ARGS after the manifest's): its program fetched, run as root, its output
#                   shown here and sent back (build/netlog/report-*.txt)
#   test-wyn k      the developer's kernel (make devkernel) into the stick's
#                   kernel slot: the next boot runs it (also leaf update -eK)
#
# The tests are a manifest on the developer's machine (tools/devhost.py
# serves build/devhost/tests.txt: "N program [arguments]" a line); that
# machine is the one boot.cfg's netlog= names. Only on a live stick.
#
# No network: the copies in the image (/usr/lib/wynland/hwtests, what
# build/devhost held when the image was made), and the report into the
# kernel log (/dev/kmsg) -- onto the stick with it: after the next boot
# it is in \logs\klog-N.log there, between "== test-wyn" lines.
HOST=$(sed -n 's/^netlog=\([0-9.]*\):.*/\1/p' /etc/wynland/boot.cfg 2>/dev/null | head -n 1)
[ -n "$HOST" ] || HOST=192.168.0.239
H=http://$HOST:8765

LOCAL=/usr/lib/wynland/hwtests
OFFLINE=0
get() {
    if [ "$OFFLINE" = 1 ]; then cp "$LOCAL/$1" "$2" 2>/dev/null; return $?; fi
    curl -sS --connect-timeout 3 --retry 2 --retry-all-errors -o "$2" "$H/$1"
}

if ! get tests.txt /tmp/test-wyn.list 2>/dev/null; then
    if [ -f "$LOCAL/tests.txt" ]; then
        OFFLINE=1
        echo "test-wyn: no answer from $H -- the image's own tests; the report goes to the stick's log"
        get tests.txt /tmp/test-wyn.list
    else
        echo "test-wyn: no answer from $H and no tests in the image -- is the network up?"
        exit 1
    fi
fi
if [ "$1" = k ]; then
    [ "$OFFLINE" = 1 ] && { echo "test-wyn k: needs the network"; exit 1; }
    # a kernel into the stick's slot (after the log in partition 3, type
    # 0x7F; on older sticks partition 4, type 0x7E): the next boot
    # runs it (boot/boot.c SlotKernel; a key at boot: the stick's own)
    get kernel.hdr /tmp/kernel.hdr && get kernel.elf /tmp/kernel.elf || { echo "test-wyn: no kernel on $H (make devkernel)"; exit 1; }
    cat > /tmp/kinstall.sh <<'EOF'
mbr() { dd if=/dev/usb0 bs=512 count=1 2>/dev/null | od -An -t"$1" -j "$2" -N "$3" | tr -d ' '; }
T=$(mbr u1 498 1); S=$(mbr u4 502 4); C=$(mbr u4 506 4)
if [ "$T" != 126 ]; then
    T3=$(mbr u1 482 1); S=$(mbr u4 486 4); C=$(mbr u4 490 4)
    if [ "$T3" != 127 ] || [ "$C" -le 8194 ]; then echo "no kernel slot on this stick: flash a newer image"; exit 1; fi
    S=$((S + 8192)); C=$((C - 8192))
fi
B=$(stat -c %s /tmp/kernel.elf)
if [ $(( (B + 511) / 512 + 1 )) -gt "$C" ]; then echo "the kernel ($B bytes) is bigger than the slot"; exit 1; fi
dd if=/tmp/kernel.elf of=/dev/usb0 bs=512 seek=$((S + 1)) conv=notrunc 2>/dev/null &&
dd if=/tmp/kernel.hdr of=/dev/usb0 bs=512 seek="$S" count=1 conv=notrunc 2>/dev/null || { echo "writing the stick failed"; exit 1; }
A=$(md5sum < /tmp/kernel.elf | cut -d' ' -f1)
R=$(dd if=/dev/usb0 bs=512 skip=$((S + 1)) count=$(( (B + 511) / 512 )) 2>/dev/null | head -c "$B" | md5sum | cut -d' ' -f1)
if [ "$A" = "$R" ]; then echo "the kernel is in the slot (LBA $S, $B bytes, read back the same): reboot to run it"
else echo "READ BACK DIFFERENT: the stick did not take it ($A / $R)"; exit 1; fi
EOF
    echo "kernel: $(dd if=/tmp/kernel.hdr bs=1 skip=16 count=64 2>/dev/null | tr -d '\000')"
    if [ "$(id -u)" = 0 ]; then sh /tmp/kinstall.sh
    elif [ "$(id -un)" = live ]; then echo live | ary -S sh /tmp/kinstall.sh
    else ary sh /tmp/kinstall.sh; fi
    exit $?
fi
if [ -z "$1" ]; then
    echo "tests on $H:"
    grep -v '^#' /tmp/test-wyn.list
    exit 0
fi
N=$1
shift
EXTRA="$*"     # test-wyn N more args: after the manifest's own
LINE=$(awk -v n="$N" '$1 == n { $1 = ""; sub(/^ +/, ""); print; exit }' /tmp/test-wyn.list)
if [ -z "$LINE" ]; then
    echo "test-wyn: no test $N; there are:"
    grep -v '^#' /tmp/test-wyn.list
    exit 1
fi
set -- $LINE $EXTRA
P=$1
shift
get "$P" "/tmp/$P" && chmod +x "/tmp/$P" || { echo "test-wyn: could not fetch $P"; exit 1; }

OUT=/tmp/test-wyn.$N.out
echo "== test $N: $P $*" > "$OUT"
# one script, run as root: the test, its output kept -- and without a
# network also into the kernel log as it comes (a line at a time: what a
# test printed before it hung the machine is on the stick all the same)
R=/tmp/test-wyn.$N.sh
{
    echo 'OUT="$1"; OFF="$2"; N="$3"; shift 3'
    echo '[ "$OFF" = 1 ] && printf "== test-wyn report %s begin: %s\r\n" "$N" "$*" > /dev/kmsg'
    echo '{ "$@"; echo $? > "$OUT.rc"; } 2>&1 | tee -a "$OUT" |'
    echo '  if [ "$OFF" = 1 ]; then while IFS= read -r l; do printf "[test-wyn] %s\r\n" "$l" > /dev/kmsg; done; else cat > /dev/null; fi'
    echo '[ "$OFF" = 1 ] && printf "== test-wyn report %s end: exit %s\r\n" "$N" "$(cat "$OUT.rc")" > /dev/kmsg'
    echo 'exit 0'
} > "$R"
tail -n +2 -f "$OUT" 2>/dev/null &     # shown as it comes (ary may ask a password: the run itself in front)
TAILER=$!
if [ "$(id -u)" = 0 ]; then
    sh "$R" "$OUT" "$OFFLINE" "$N" "/tmp/$P" "$@"
elif [ "$(id -un)" = live ]; then
    echo live | ary -S sh "$R" "$OUT" "$OFFLINE" "$N" "/tmp/$P" "$@"     # the live stick's account
else
    ary sh "$R" "$OUT" "$OFFLINE" "$N" "/tmp/$P" "$@"
fi
sleep 1; kill $TAILER 2>/dev/null
echo "== exit $(cat "$OUT.rc" 2>/dev/null)" >> "$OUT"
echo "== exit $(cat "$OUT.rc" 2>/dev/null)"
if [ "$OFFLINE" = 1 ]; then
    echo "(in the kernel log: boot once more from the stick, then \\logs\\klog-N.log on it -- the newest)"
    exit 0
fi
if curl -sS --retry 5 --retry-all-errors --data-binary "@$OUT" "$H/report" >/dev/null; then
    echo "(sent to $HOST)"
else
    echo "(could not send it to $HOST: show this screen instead)"
fi
