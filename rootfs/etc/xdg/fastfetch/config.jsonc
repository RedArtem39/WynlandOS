// WynlandOS: fastfetch with our logo (a user's own
// ~/.config/fastfetch/config.jsonc replaces this one)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/wynland/logo.txt",
        "color": {
            "1": "38;2;110;200;255",
            "2": "38;2;50;140;245",
            "3": "38;2;35;80;225"
        },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "color": { "keys": "38;2;50;140;245", "title": "38;2;110;200;255" }
    },
    "modules": [
        "title", "separator",
        "os", "host", "kernel", "uptime", "packages", "shell", "display", "wm",
        "terminal", "cpu", "gpu", "memory", "disk", "localip", "locale",
        "break", "colors"
    ]
}
