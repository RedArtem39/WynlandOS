/* missing line 1069 */
        file->dir_entry_sector = 0;
        file->dir_entry_offset = 0;
        file->dirty = false;
        return file;
    }
    if (str_compare(path, "/dev/null") == 0 || path_ends_with(path, "/dev/null") || path_ends_with(path, "dev/null")) {
        /* git-port regression (task tracking this session): git's own
           die()/common setup unconditionally opens /dev/null for
           various redirects; with no device backing it at all, that
           open() failed and whatever git did next hung indefinitely --
           real, previously-latent gap, first surfaced by porting a
           real program that actually depends on this existing (every
           prior port either didn't need it or worked around not
           having it). Real /dev/null semantics: writes discard
           everything, reads always return EOF immediately -- see
           vfs_read()/vfs_write()'s 0xFFFFFFFE branches below. */
        VfsFile *file = (VfsFile *)kmalloc(sizeof(VfsFile));
        if (!file) return NULL;
        str_copy(file->node.name, "null");
        file->node.size = 0;
        file->node.is_dir = false;
        file->node.readonly = false;
        file->node.mode = 0666;
        file->node.uid = 0;
        file->node.first_cluster = 0xFFFFFFFE;
        file->offset = 0;
        file->current_cluster = 0;
        file->current_cluster_offset = 0;
        file->flags = flags;
