; WynlandOS - Custom Assembly Demo Application
; ============================================================

main:
    ; Create window: sys 2. Params: r1=x, r2=y, r3=w, r4=h, r5=title
    mov r1, 120
    mov r2, 100
    mov r3, 300
    mov r4, 200
    mov r5, win_title
    sys 2
    mov r7, r0          ; Store winID in r7

    ; Fill window body (sys 3)
    mov r0, r7
    mov r1, 0
    mov r2, 0
    mov r3, 298
    mov r4, 170         ; cw and ch inside
    mov r5, 0xECEFF4    ; Nord6 Paper color
    sys 3

    ; Draw a nice greeting string (sys 4)
    mov r0, r7
    mov r1, 20
    mov r2, 25
    mov r3, 0x2E3440    ; Nord0 Dark color
    mov r4, greet_msg
    sys 4

    ; Draw instruction string
    mov r0, r7
    mov r1, 20
    mov r2, 50
    mov r3, 0x5E81AC    ; Nord10 Accent blue
    mov r4, click_msg
    sys 4

    ; Draw initial decorative shapes
    mov r0, r7
    mov r1, 40
    mov r2, 90
    mov r3, 50
    mov r4, 40
    mov r5, 0xBF616A    ; Nord11 Red rect
    sys 3

    mov r0, r7
    mov r1, 200
    mov r2, 110
    mov r3, 25          ; radius
    mov r4, 0xA3BE8C    ; Nord14 Green circle
    sys 6

event_loop:
    ; Yield so we don't hog CPU (sys 8)
    sys 8

    ; Check mouse status (sys 7)
    mov r0, r7
    sys 7               ; r0=mx, r1=my, r2=buttons
    
    cmp r2, 1           ; Check if left mouse button is pressed
    jne event_loop      ; If not pressed, continue loop

    ; Draw a small dot at mouse pointer position (sys 6)
    ; r0 has mx, r1 has my. Let's move them to r1, r2.
    mov r2, r1          ; r2 = my
    mov r1, r0          ; r1 = mx
    mov r0, r7          ; r0 = winID
    mov r3, 6           ; radius
    mov r4, 0xD08770    ; Nord12 Orange paint dot
    sys 6

    jmp event_loop

; Data section: title and string constants
win_title: "WynVM Interactive Paint"
greet_msg: "Welcome to WynVM custom app!"
click_msg: "Click inside window to paint dots"
