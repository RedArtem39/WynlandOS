# WynLang OS Features Demonstration

print("Welcome to WynLang in WynlandOS!")

# 1. Variables and Arithmetic
x = 20
y = 22
sum = x + y
print("x + y =", sum)

# 2. String operations
greeting = "Hello " + "from WynLang!"
print(greeting)

# 3. Functions
fn factorial(n):
    if n <= 1:
        return 1
    end
    return n * factorial(n - 1)
end

print("factorial(5) =", factorial(5))

# 4. Conditional Statement
test = 150
if test > 100:
    print("test is large")
elif test > 50:
    print("test is medium")
else:
    print("test is small")
end

# 5. OS filesystem operations
print("Creating a file via WynLang OS API...")
write("/wyn_demo.txt", "This file was written from a WynLang script!")

if exists("/wyn_demo.txt"):
    print("File exists! Reading contents:")
    content = read("/wyn_demo.txt")
    print("Contents:", content)
else:
    print("File write failed!")
end

# 6. Listing files
print("Files in root directory:")
ls("/")

print("WynLang execution finished.")
