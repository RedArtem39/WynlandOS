IMPLICIT = {"debconf": ("perl-base",)}

USE_COLOR = sys.stdout.isatty()


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if USE_COLOR else s


def say(msg):
    print(c("1;34", "::") + " " + msg, flush=True)


def warn(msg):
    print(c("1;33", "warning:") + " " + msg, file=sys.stderr, flush=True)


def die(msg):
    print(c("1;31", "error:") + " " + msg, file=sys.stderr, flush=True)
    sys.exit(1)


# ------------------------------------------------------------------ versions

def _order(ch):
    if ch == "~":
        return -1
    if ch.isdigit():
        return 0
    if ch.isalpha():
        return ord(ch)
    return ord(ch) + 256 if ch else 0


def _cmp_part(a, b):
    """dpkg's comparison of upstream versions / revisions"""
    i = j = 0
    while i < len(a) or j < len(b):
        first_diff = 0
        while (i < len(a) and not a[i].isdigit()) or (j < len(b) and not b[j].isdigit()):
            ac = _order(a[i]) if i < len(a) else 0
            bc = _order(b[j]) if j < len(b) else 0
            if ac != bc:
                return ac - bc
            i += 1
            j += 1
        while i < len(a) and a[i] == "0":
            i += 1
        while j < len(b) and b[j] == "0":
            j += 1
        while i < len(a) and a[i].isdigit() and j < len(b) and b[j].isdigit():
            if not first_diff:
                first_diff = ord(a[i]) - ord(b[j])
            i += 1
            j += 1
        if i < len(a) and a[i].isdigit():
            return 1
        if j < len(b) and b[j].isdigit():
            return -1
        if first_diff:
            return first_diff
    return 0


def _split_version(v):
    epoch, _, rest = v.rpartition(":") if ":" in v else ("0", "", v)
    if "-" in rest:
        up, _, rev = rest.rpartition("-")
    else:
        up, rev = rest, ""
    return int(epoch or 0), up, rev


def vcmp(a, b):
    ea, ua, ra = _split_version(a)
    eb, ub, rb = _split_version(b)
    if ea != eb:
        return ea - eb
    return _cmp_part(ua, ub) or _cmp_part(ra, rb)


def satisfies(have, op, want):
    r = vcmp(have, want)
    return {"<<": r < 0, "<=": r <= 0, "=": r == 0, ">=": r >= 0, ">>": r > 0,
            "<": r <= 0, ">": r >= 0}[op]


def prov_ok(pver, op, ver):
    """a Provides entry of version pver (None: unversioned) for a dependency
    (op, ver): dpkg lets an unversioned one meet only unversioned needs"""
    if op is None:
        return True
    return pver is not None and satisfies(pver, op, ver)


def parse_rel(field):
    """'a (>= 1) | b, c:any' -> [[('a','>=','1'), ('b',None,None)], [('c',None,None)]]"""
    out = []
    for group in field.split(","):
        alts = []
        for alt in group.split("|"):
            alt = alt.strip()
            if not alt:
                continue
            if "[" in alt:          # architecture restrictions: we are amd64
                alt = alt[:alt.index("[")].strip()
            if "<" in alt and alt.rstrip().endswith(">") and "(" not in alt[alt.index("<"):]:
                alt = alt[:alt.index("<")].strip()    # build profiles
            op = ver = None
            if "(" in alt:
                name, _, rest = alt.partition("(")
                rest = rest.rstrip(") ").strip()
                for o in ("<<", "<=", ">=", ">>", "=", "<", ">"):
                    if rest.startswith(o):
                        op, ver = o, rest[len(o):].strip()
                        break
                alt = name.strip()
            name = alt.split(":")[0]
            alts.append((name, op, ver))
        if alts:
            out.append(alts)
    return out


# ------------------------------------------------------------------ sources

def read_sources():
    """lines: deb URL SUITE COMPONENT..."""
    path = os.path.join(ETC, "sources")
    out = []
    try:
        for line in open(path):
            f = line.split("#", 1)[0].split()
            if len(f) >= 4 and f[0] == "deb":
                out.append((f[1].rstrip("/"), f[2], f[3:]))
    except FileNotFoundError:
        die(f"no {path}")
    return out


def fetch(url, dest=None, quiet=False):
    """download url (to dest, or into memory), with a progress line -- a
    stalled or dropped connection (a slow mirror) tried again, three times,
    from the start, before the error is the user's"""
    for attempt in range(3):
        try:
            return fetch_once(url, dest, quiet)
        except (TimeoutError, ConnectionError, urllib.error.URLError, http.client.HTTPException) as e:
            # the mirror's name not found: no network at all (Wi-Fi not
            # connected) -- asking again will not help, and the bare
            # "Temporary failure in name resolution" says nothing
            if isinstance(getattr(e, "reason", None), socket.gaierror):
                die(f"no network: {url.split('/')[2]} is not found -- connect to Wi-Fi "
                    f"(the bar, or: wifi connect NAME) or a phone's tethering, then again")
            if isinstance(e, urllib.error.HTTPError) and e.code < 500:
                raise                          # 404 and the like: no use asking again
            if attempt == 2:
                die(f"{url}: {e}")
            warn(f"{os.path.basename(url)}: {e} -- again in 5 s")
            time.sleep(5)


def fetch_once(url, dest=None, quiet=False):
    req = urllib.request.Request(url, headers={"User-Agent": "leaf/1 (WynlandOS)"})
    with urllib.request.urlopen(req, timeout=60) as r:
        total = int(r.headers.get("Content-Length") or 0)
        buf = io.BytesIO() if dest is None else open(dest + ".part", "wb")
        got = 0
        t0 = time.monotonic()
        while True:
            chunk = r.read(65536)
            if not chunk:
                break
            buf.write(chunk)
            got += len(chunk)
            if not quiet and USE_COLOR and total:
                rate = got / max(time.monotonic() - t0, 0.001)
                print(f"\r   {os.path.basename(url)[:48]:48} {got * 100 // total:3d}%  {rate / 1e6:5.1f} MB/s",
                      end="", flush=True)
        if not quiet and USE_COLOR and total:
            print("\r" + " " * 78 + "\r", end="", flush=True)
        if dest is None:
            return buf.getvalue()
        buf.close()
        os.replace(dest + ".part", dest)
        return None


def list_name(url, suite, comp):
    host = url.split("://", 1)[-1].replace("/", "_")
    return f"{host}_{suite}_{comp}"


def cmd_update(args):
    # -eK: the kernel from the developer's machine into a live stick's slot
    # (rootfs/usr/bin/test-wyn k), for the next boot -- not a package
    if "-eK" in args:
        if not shutil.which("test-wyn"):
            die("-eK: only on a live stick (test-wyn is not here)")
        os.execvp("test-wyn", ["test-wyn", "k"])
    need_root()
    os.makedirs(LISTS, exist_ok=True)
    have_gpgv = shutil.which("gpgv") and os.path.exists(KEYRING)
    if not have_gpgv:
        warn("gpgv or the Ubuntu keyring is missing: the index is NOT checked")
    for url, suite, comps in read_sources():
        say(f"{url} {suite}")
        # a mirror syncing between the InRelease and the index gives a
        # checksum mismatch (apt's "Hash Sum mismatch"): all of the suite
        # again, a few times, before giving up
        for attempt in range(3):
            try:
                update_suite(url, suite, comps, have_gpgv)
                break
            except ChecksumMismatch as e:
                if attempt == 2:
                    die(str(e))
                warn(f"{e}: the mirror is syncing? again in 5 s")
                time.sleep(5)
    say("done")


class ChecksumMismatch(Exception):
    pass


def update_suite(url, suite, comps, have_gpgv):
    signed = fetch(f"{url}/dists/{suite}/InRelease", quiet=True)
    if have_gpgv:
        with tempfile.NamedTemporaryFile(delete=False) as t:
            t.write(signed)
        r = subprocess.run(["gpgv", "--keyring", KEYRING, t.name],
                           capture_output=True, text=True)
        os.unlink(t.name)
        if r.returncode != 0:
            die(f"bad signature on {suite}/InRelease:\n{r.stderr}")
    text = signed.decode("utf-8", "replace")
    # the SHA256 list of the files the release describes
    sums = {}
    in_sha = False
    for line in text.splitlines():
        if line.startswith("SHA256:"):
            in_sha = True
            continue
        if in_sha:
            if not line.startswith(" "):
                in_sha = False
                continue
            h, size, name = line.split()
            sums[name] = (h, int(size))
    for comp in comps:
        rel = f"{comp}/binary-{ARCH}/Packages.xz"
        if rel not in sums:
            warn(f"{suite}/{rel}: not in the release")
            continue
        data = fetch(f"{url}/dists/{suite}/{rel}")
        if hashlib.sha256(data).hexdigest() != sums[rel][0]:
            raise ChecksumMismatch(f"{suite}/{rel}: checksum mismatch")
        packages = lzma.decompress(data)
        index = parse_packages(packages, url)
        with open(os.path.join(LISTS, list_name(url, suite, comp) + ".json"), "w") as f:
            json.dump(index, f, separators=(",", ":"))
        print(f"   {comp}: {len(index)} packages")


KEEP = ("Package", "Version", "Depends", "Pre-Depends", "Recommends", "Provides", "Filename",
        "Size", "SHA256", "Description", "Installed-Size", "Section", "Conflicts",
        "Breaks", "Replaces", "Architecture", "Essential", "Priority")


def parse_packages(raw, url):
    out = []
    for para in raw.decode("utf-8", "replace").split("\n\n"):
        rec = {}
        for line in para.split("\n"):
            if not line or line[0] in " \t":
                continue
            k, _, v = line.partition(":")
            if k in KEEP:
                rec[k] = v.strip()
        if "Package" in rec and rec.get("Architecture") in (ARCH, "all"):
            rec["_url"] = url
            out.append(rec)
    return out


# ------------------------------------------------------------------ the index

class Index:
    def __init__(self):
        self.pkgs = {}       # name -> newest record
        self.provides = {}   # virtual -> [(name, version it provides or None)]
        if not os.path.isdir(LISTS) or not os.listdir(LISTS):
            die("no package lists: run 'leaf update'")
        for fn in sorted(os.listdir(LISTS)):
            if not fn.endswith(".json"):
                continue
            for rec in json.load(open(os.path.join(LISTS, fn))):
                name = rec["Package"]
                old = self.pkgs.get(name)
                if old is None or vcmp(rec["Version"], old["Version"]) > 0:
                    self.pkgs[name] = rec
        for name, rec in self.pkgs.items():
            for alts in parse_rel(rec.get("Provides", "")):
                for pname, _, pver in alts:
                    self.provides.setdefault(pname, []).append((name, pver))


class State:
    """what is installed: leaf's own (with files) and the image's base"""

    def __init__(self):
        try:
            self.db = json.load(open(DB))
        except (FileNotFoundError, json.JSONDecodeError):
            self.db = {}
        self.base = {}
        self.base_prov = {}      # what the image's packages Provide: {name: [(pkg, version)]}
        try:
            for line in open(BASE):
                line, _, prov = line.rstrip("\n").partition("\t")
                f = line.split()
                if len(f) >= 2:
                    self.base[f[0]] = f[1]
                    for alts in parse_rel(prov):
                        for pname, _, pver in alts:
                            self.base_prov.setdefault(pname, []).append((f[0], pver))
        except FileNotFoundError:
            pass

    def version(self, name):
        if name in self.db:
            return self.db[name]["version"]
        return self.base.get(name)

    def provided(self, name, op=None, ver=None):
        """installed packages that Provide name (at a version meeting op ver)"""
        out = []
        for n, rec in self.db.items():
            pv = rec.get("provides_v", {})
            if name in pv:
                if prov_ok(pv[name], op, ver):
                    out.append(n)
            elif op is None and name in rec.get("provides", []):
                out.append(n)
        # the image's (libqt6core6t64's qt6-base-private-abi (= 6.10.2): every
        # Qt module needs it, and it was "unmet")
        out += [n for n, pv in self.base_prov.get(name, ()) if n not in self.db and prov_ok(pv, op, ver)]
        return out

    def save(self):
        os.makedirs(LIB, exist_ok=True)
        tmp = DB + ".new"
        with open(tmp, "w") as f:
            json.dump(self.db, f, indent=1)
        os.replace(tmp, DB)


def dep_met(state, plan, name, op, ver):
    v = plan[name]["Version"] if name in plan else state.version(name)
    if v is not None and (op is None or satisfies(v, op, ver)):
        return True
    if state.provided(name, op, ver) or any(
            a[0] == name and prov_ok(a[2], op, ver)
            for r in plan.values() for g in parse_rel(r.get("Provides", "")) for a in g):
        return True
    return False


def resolve(index, state, names, upgrade=False, recommends=True):
    """the records to install for names, dependencies first"""
    plan = {}
    order = []
    missing = []
    held = []

    def want(name, op=None, ver=None, why=None):
        if dep_met(state, plan, name, op, ver) and not (upgrade and why is None):
            return True
        rec = index.pkgs.get(name)
        if rec is None:
            # a virtual package: each provider in turn, until one fits
            provs = [index.pkgs[p] for p, pv in index.provides.get(name, []) if prov_ok(pv, op, ver)]
            if len(provs) > 1:
                return try_alts([(p["Package"], None, None) for p in provs], why)
            rec = provs[0] if provs else None
        if rec is None or (op and rec["Package"] == name and not satisfies(rec["Version"], op, ver)):
            return False
        n = rec["Package"]
        if n in plan:
            return True
        # the image's own packages (glibc first of all) are never replaced:
        # a dependency on another version of one is unmet, not a downgrade
        # of the system's libc under every program (a stale index once had
        # libc6-dev want libc6 2.43-2ubuntu2 against the image's ...2.4)
        if n in state.base and n not in state.db:
            held.append(f"{n} {state.base[n]}")
            return False
        plan[n] = rec
        ok = True
        # Essential packages are never named as dependencies (Debian assumes
        # them); the ones the image does not have are added where they are
        # needed: debconf's frontend is perl ("frontend: not found" broke
        # iproute2's postinst)
        implicit = ",".join(IMPLICIT.get(n, ()))
        for field in ("Pre-Depends", "Depends", None):
            for alts in parse_rel(rec.get(field, "") if field else implicit):
                if any(dep_met(state, plan, a, o, v) for a, o, v in alts):
                    continue
                if not try_alts(alts, n):
                    missing.append(f"{n} needs {' | '.join(a + (f' ({o} {v})' if o else '') for a, o, v in alts)}")
                    ok = False
        # Recommends, as apt installs them (APT::Install-Recommends): what
        # a program needs to be whole -- Qt5 programs' Wayland plugin
        # (qtwayland5: without it VLC never showed a window), wine's X
        # libraries. One that cannot be had is left out, never an error.
        # Ubuntu's base system (priority required, important, standard: apt,
        # locales, ca-certificates, perl, openssl ...) apt always finds
        # installed, so it never pulls those in as recommendations -- here
        # neither: the image is the base system.
        if recommends and ok:
            for alts in parse_rel(rec.get("Recommends", "")):
                if any(dep_met(state, plan, a, o, v) for a, o, v in alts):
                    continue
                # (a group with a base package in it is met on Ubuntu:
                # "locales | locales-all" pulled the 200 MB locales-all)
                if any(index.pkgs.get(a, {}).get("Priority") in ("required", "important", "standard")
                       for a, o, v in alts):
                    continue
                try_soft(alts, n)
        order.append(n)
        return ok

    def try_soft(alts, why):
        """a recommendation: the first alternative that resolves cleanly,
        else nothing -- and nothing it planned stays"""
        for a, o, v in alts:
            snap = (dict(plan), len(order), len(missing), len(held))
            if want(a, o, v, why=why) and len(missing) == snap[2]:
                return True
            plan.clear()
            plan.update(snap[0])
            del order[snap[1]:], missing[snap[2]:], held[snap[3]:]
        return False

    def try_alts(alts, why):
        """the first of 'a | b | c' that resolves with all it needs; what a
        failed one put in the plan is taken out again before the next is
        tried (systemd, needing a newer libsystemd0 than the image's, used
        to sink evince although another alternative fitted)"""
        first = None
        for a, o, v in alts:
            snap = (dict(plan), len(order), len(missing), len(held))
            if want(a, o, v, why=why):
                return True
            if first is None:
                first = (missing[snap[2]:], held[snap[3]:])
            plan.clear()
            plan.update(snap[0])
            del order[snap[1]:], missing[snap[2]:], held[snap[3]:]
        if first:   # (why the first, preferred one did not fit)
            missing.extend(first[0])
            held.extend(first[1])
        return False

    for name in names:
        if name not in index.pkgs and name not in index.provides:
            die(f"no package called '{name}'")
        if not upgrade and state.version(name) is not None and name not in state.db:
            say(f"{name} came with the system")
            continue
        if not upgrade and name in state.db:
            say(f"{name} {state.db[name]['version']} is installed already")
            continue
        if not want(name) and not missing:
            die(f"cannot install {name}")
    if missing:
        msg = "unmet dependencies:\n  " + "\n  ".join(missing)
        if held:
            msg += ("\nthe system's own packages stay as they are (" + ", ".join(sorted(set(held))) +
                    "): 'leaf update' may bring versions that fit them")
        die(msg)
    return [plan[n] for n in order]


# ------------------------------------------------------------------ .deb

def ar_members(path):
    with open(path, "rb") as f:
        if f.read(8) != b"!<arch>\n":
            raise ValueError("not a .deb")
        while True:
            hdr = f.read(60)
            if len(hdr) < 60:
                return
            name = hdr[:16].decode().strip().rstrip("/")
            size = int(hdr[48:58].decode().strip())
            data = f.read(size)
            if size % 2:
                f.read(1)
            yield name, data


def open_tar(name, data):
    if name.endswith(".zst"):
        import compression.zstd
        data = compression.zstd.decompress(data)
        return tarfile.open(fileobj=io.BytesIO(data), mode="r:")
    return tarfile.open(fileobj=io.BytesIO(data), mode="r:*")


def unpack(deb):
    """(control dict, scripts dict, data tarfile)"""
    control, scripts, data = {}, {}, None
    for name, blob in ar_members(deb):
        if name.startswith("control.tar"):
            t = open_tar(name, blob)
            for m in t.getmembers():
                base = m.name.lstrip("./")
                if not m.isfile():
                    continue
                content = t.extractfile(m).read()
                if base == "control":
                    for line in content.decode("utf-8", "replace").splitlines():
                        if line and line[0] not in " \t" and ":" in line:
                            k, _, v = line.partition(":")
                            control[k] = v.strip()
                elif base in ("preinst", "postinst", "prerm", "postrm", "conffiles"):
                    scripts[base] = content
        elif name.startswith("data.tar"):
            data = open_tar(name, blob)
    return control, scripts, data


def run_script(pkg, which, scripts, *args):
    body = scripts.get(which)
    if not body:
        return
    with tempfile.NamedTemporaryFile(delete=False, suffix="." + which) as t:
        t.write(body)
    os.chmod(t.name, 0o755)
    env = dict(os.environ, DPKG_MAINTSCRIPT_PACKAGE=pkg, DPKG_MAINTSCRIPT_NAME=which,
               DPKG_MAINTSCRIPT_ARCH=ARCH, DEBIAN_FRONTEND="noninteractive", DPKG_ROOT="")
    r = subprocess.run([t.name, *args], env=env, capture_output=True, text=True)
    os.unlink(t.name)
    if r.returncode != 0:
        warn(f"{pkg}: {which} {' '.join(args)} failed ({r.returncode}); carrying on\n"
             + (r.stderr.strip()[-600:] if r.stderr else ""))


def install_deb(state, rec, path, conffiles_keep=True):
    pkg = rec["Package"]
    control, scripts, data = unpack(path)
    if data is None:
        raise ValueError(f"{pkg}: no data in the .deb")
    old = state.db.get(pkg)
    run_script(pkg, "preinst", scripts, "upgrade" if old else "install", *( [old["version"]] if old else []))
    conffiles = set()
    if "conffiles" in scripts:
        conffiles = {l.strip() for l in scripts["conffiles"].decode().splitlines() if l.strip().startswith("/")}
    files = []
    dirs = []
    for m in data.getmembers():
        name = m.name if m.name.startswith("./") else "./" + m.name
        if name == "./" or name.startswith(SKIP_PREFIXES):
            continue
        rel = os.path.normpath(name[2:])
        if rel.startswith("..") or os.path.isabs(rel):
            raise ValueError(f"{pkg}: path outside the root: {m.name}")
        dest = os.path.join(ROOT, rel)
        abspath = "/" + rel
        if m.isdir():
            os.makedirs(dest, exist_ok=True)
            dirs.append(abspath)
            continue
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if abspath in OS_IDENTITY:
            continue                       # the system says it is WynlandOS, whatever a package ships
        if abspath in conffiles and conffiles_keep and os.path.exists(dest) and old:
            files.append(abspath)          # the user's config stays; the new one beside it
            dest = dest + ".leaf-new"
        tmp = dest + ".leaf-tmp"
        if os.path.lexists(tmp):
            os.unlink(tmp)
        if m.issym():
            os.symlink(m.linkname, tmp)
        elif m.islnk():
            target = os.path.join(ROOT, os.path.normpath(m.linkname.lstrip("./")))
            shutil.copy2(target, tmp)
        elif m.isfile():
            with data.extractfile(m) as src, open(tmp, "wb") as out:
                shutil.copyfileobj(src, out, 1 << 20)
            os.chmod(tmp, m.mode & 0o7777)
        else:
            continue                        # devices, fifos: not in normal packages
        if os.path.isdir(dest) and not os.path.islink(dest):
            os.unlink(tmp)
            warn(f"{pkg}: {abspath} is a directory here; skipped")
            continue
        os.replace(tmp, dest)
        if not dest.endswith(".leaf-new"):
            files.append(abspath)
    provides = [a[0] for g in parse_rel(control.get("Provides", "")) for a in g]
    provides_v = {a[0]: a[2] for g in parse_rel(control.get("Provides", "")) for a in g}
    if old:
        for f in set(old.get("files", [])) - set(files):
            p = os.path.join(ROOT, f.lstrip("/"))
            if os.path.lexists(p) and not os.path.isdir(p):
                os.unlink(p)
    state.db[pkg] = {"version": control.get("Version", rec["Version"]), "files": files, "dirs": dirs,
                     "provides": provides, "provides_v": provides_v, "depends": control.get("Depends", ""),
                     "summary": control.get("Description", "").split("\n")[0],
                     "postrm": (scripts.get("postrm") or b"").decode("utf-8", "replace"),
                     "prerm": (scripts.get("prerm") or b"").decode("utf-8", "replace"),
                     "auto": state.db.get(pkg, {}).get("auto", True)}
    state.save()
    return scripts, old


class KeepAlive:
    """one HTTP connection kept open across requests to the same mirror (a
    new one per package cost a name lookup, a TCP handshake and a slow
    start each -- most of the time with many small packages)"""

    def __init__(self):
        self.conn = None
        self.key = None

    def close(self):
        if self.conn:
            try:
                self.conn.close()
            except Exception:
                pass
        self.conn = None

    def get(self, url, hops=0):
        u = urllib.parse.urlsplit(url)
        key = (u.scheme, u.netloc)
        if self.conn is None or self.key != key:
            self.close()
            cls = http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection
            self.conn, self.key = cls(u.netloc, timeout=60), key
        path = (u.path or "/") + ("?" + u.query if u.query else "")
        self.conn.request("GET", path, headers={"User-Agent": "leaf/1 (WynlandOS)"})
        r = self.conn.getresponse()
        if r.status in (301, 302, 303, 307, 308) and hops < 5:
            loc = r.getheader("Location") or ""
            r.read()
            return self.get(urllib.parse.urljoin(url, loc), hops + 1)
        if r.status != 200:
            r.read()
            raise urllib.error.HTTPError(url, r.status, r.reason, r.headers, None)
        if r.getheader("Connection", "").lower() == "close":
            self.key = None                    # (read to the end, then a new one next time)
        return r


DOWNLOADERS = 4                                # packages fetched at once


def download(recs):
    """the packages not in the cache yet, DOWNLOADERS at once, each worker
    keeping its connection to the mirror; one progress line for all"""
    os.makedirs(CACHE, exist_ok=True)
    paths, todo = {}, []
    for r in recs:
        path = os.path.join(CACHE, os.path.basename(r["Filename"]))
        paths[r["Package"]] = path
        if path in (t[1] for t in todo):
            continue                           # (one file, once: two workers on one .part would mix it)
        if not (os.path.exists(path) and sha256_file(path) == r["SHA256"]):
            todo.append((r, path))
    total = sum(int(r.get("Size", 0)) for r, _ in todo)
    say(f"downloading {len(todo)} package(s), {total / 1e6:.1f} MB" +
        (f" ({len(recs) - len(todo)} already here)" if len(todo) < len(recs) else ""))
    if not todo:
        return paths

    lock = threading.Lock()
    st = {"got": 0, "done": 0, "next": 0, "errors": []}

    def one(conn, r, path):
        url = f"{r['_url']}/{r['Filename']}"
        for attempt in range(3):
            got = 0
            try:
                resp = conn.get(url)
                with open(path + ".part", "wb") as f:
                    while True:
                        chunk = resp.read(1 << 17)
                        if not chunk:
                            break
                        f.write(chunk)
                        got += len(chunk)
                        with lock:
                            st["got"] += len(chunk)
                os.replace(path + ".part", path)
                if sha256_file(path) != r["SHA256"]:
                    os.unlink(path)
                    return f"{r['Package']}: checksum mismatch -- not installing"
                return None
            except (OSError, http.client.HTTPException, urllib.error.URLError) as e:
                conn.close()
                with lock:
                    st["got"] -= got           # (counted again from the start)
                if isinstance(e, urllib.error.HTTPError) and e.code < 500:
                    return f"{url}: {e}"
                if attempt == 2:
                    return f"{url}: {e}"
                time.sleep(2)

    def worker():
        conn = KeepAlive()
        try:
            while True:
                with lock:
                    if st["errors"] or st["next"] >= len(todo):
                        return
                    r, path = todo[st["next"]]
                    st["next"] += 1
                err = one(conn, r, path)
                with lock:
                    st["done"] += 1
                    if err:
                        st["errors"].append(err)
        finally:
            conn.close()

    threads = [threading.Thread(target=worker, daemon=True) for _ in range(min(DOWNLOADERS, len(todo)))]
    t0 = time.monotonic()
    for t in threads:
        t.start()
    while any(t.is_alive() for t in threads):
        for t in threads:
            t.join(0.25)
        if USE_COLOR:
            with lock:
                got, done = st["got"], st["done"]
            rate = got / max(time.monotonic() - t0, 0.001)
            print(f"\r   {done}/{len(todo)} packages  {got / 1e6:6.1f} of {total / 1e6:.1f} MB  {rate / 1e6:5.2f} MB/s ",
                  end="", flush=True)
    if USE_COLOR:
        print("\r" + " " * 78 + "\r", end="", flush=True)
    if st["errors"]:
        die(st["errors"][0])
    secs = time.monotonic() - t0
    say(f"downloaded {total / 1e6:.1f} MB in {secs:.1f} s ({total / 1e6 / max(secs, 0.001):.2f} MB/s)")
    return paths


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def need_root():
    if ROOT == "/" and os.geteuid() != 0:
        die("this changes the system: run it as root (ary)")


def do_install(index, state, recs, explicit):
    if not recs:
        return
    size = sum(int(r.get("Installed-Size", 0)) for r in recs)
    print("   " + " ".join(c("1", r["Package"]) + " " + c("2", r["Version"]) for r in recs))
    print(f"   about {size / 1024:.1f} MB on disk")
    paths = download(recs)
    done = []
    for r in recs:
        print(f"   {c('32', 'unpacking')} {r['Package']}", flush=True)
        try:
            scripts, old = install_deb(state, r, paths[r["Package"]])
        except Exception as e:
            die(f"{r['Package']}: {e}")
        done.append((r, scripts, old))
    for r, scripts, old in done:
        run_script(r["Package"], "postinst", scripts, "configure", *([old["version"]] if old else []))
    for name in explicit:
        if name in state.db:
            state.db[name]["auto"] = False
    state.save()
    update_caches()
    say(f"installed {len(recs)} package(s)")


# ------------------------------------------------------------------ commands

def no_recommends(args):
    """--no-install-recommends (apt's) or --no-recommends: only what the
    packages depend on"""
    flags = {"--no-install-recommends", "--no-recommends"}
    return [a for a in args if a not in flags], not any(a in flags for a in args)


def update_caches():
    """what dpkg's triggers do after packages come and go: GSettings
    schemas compiled, gdk-pixbuf's loaders and GIO's modules listed, MIME,
    icons, desktop files, fonts (rootfs/usr/lib/wynland/update-caches) --
    without them GTK programs had no settings and could not load an icon"""
    tool = os.path.join(ROOT, "usr/lib/wynland/update-caches")
    if ROOT == "/" and os.access(tool, os.X_OK):
        say("updating caches (schemas, icons, MIME, fonts)")
        subprocess.run([tool, "all"])


def cmd_install(args):
    need_root()
    args, rec = no_recommends(args)
    index, state = Index(), State()
    recs = resolve(index, state, args, recommends=rec)
    do_install(index, state, recs, args)


def cmd_upgrade(args):
    need_root()
    index, state = Index(), State()
    old = [n for n, r in state.db.items() if n in index.pkgs and vcmp(index.pkgs[n]["Version"], r["version"]) > 0]
    if not old:
        say("everything is up to date")
        return
    recs = resolve(index, state, old, upgrade=True)
    recs = [r for r in recs if state.version(r["Package"]) != r["Version"]]
    do_install(index, state, recs, [])


def cmd_remove(args):
    need_root()
    state = State()
    for name in args:
        if name not in state.db:
            if name in state.base:
                die(f"{name} is part of the system image; leaf does not remove it")
            die(f"{name} is not installed")
    # who still depends on what goes
    for name in args:
        users = [n for n, r in state.db.items() if n not in args and
                 any(a[0] == name for g in parse_rel(r.get("depends", "")) for a in g)]
        if users:
            die(f"{name} is needed by {', '.join(users)}")
    for name in args:
        rec = state.db[name]
        scripts = {k: rec[k].encode() for k in ("prerm", "postrm") if rec.get(k)}
        run_script(name, "prerm", scripts, "remove")
        for f in rec["files"]:
            p = os.path.join(ROOT, f.lstrip("/"))
            if os.path.lexists(p) and not os.path.isdir(p):
                os.unlink(p)
        for d in sorted(rec.get("dirs", []), key=len, reverse=True):
            try:
                os.rmdir(os.path.join(ROOT, d.lstrip("/")))
            except OSError:
                pass                     # not empty: shared with others
        run_script(name, "postrm", scripts, "remove")
        del state.db[name]
        state.save()
        print(f"   {c('31', 'removed')} {name}")
    update_caches()
    # dependencies nothing needs any more
    orphans = [n for n, r in state.db.items() if r.get("auto") and not any(
        a[0] == n for o in state.db.values() for g in parse_rel(o.get("depends", "")) for a in g)]
    if orphans:
        print("   no longer needed: " + " ".join(orphans) + "  (leaf remove them to free the space)")


def cmd_search(args):
    index = Index()
    words = [w.lower() for w in args]
    hits = []
    for name, r in index.pkgs.items():
        summary = r.get("Description", "")
        hay = (name + " " + summary).lower()
        if all(w in hay for w in words):
            hits.append((0 if any(w in name for w in words) else 1, name, r["Version"], summary))
    state = State()
    for _, name, ver, summary in sorted(hits)[:200]:
        mark = c("32", " [installed]") if state.version(name) else ""
        print(f"{c('1', name)} {c('2', ver)}{mark}\n    {summary}")
    if len(hits) > 200:
        print(f"... and {len(hits) - 200} more")


def cmd_show(args):
    index, state = Index(), State()
    for name in args:
        r = index.pkgs.get(name)
        if not r:
            die(f"no package called '{name}'")
        print(f"{c('1', name)} {r['Version']}  ({r.get('Section', '?')})")
        print(f"  {r.get('Description', '')}")
        print(f"  installed:  {state.version(name) or 'no'}")
        print(f"  download:   {int(r.get('Size', 0)) / 1e6:.2f} MB, on disk {int(r.get('Installed-Size', 0)) / 1024:.2f} MB")
        for f in ("Depends", "Pre-Depends", "Provides"):
            if r.get(f):
                print(f"  {f.lower() + ':':11} {r[f]}")


def cmd_list(args):
    state = State()
    if "--base" in args:
        for n, v in sorted(state.base.items()):
            print(f"{n} {c('2', v)}")
        return
    for n, r in sorted(state.db.items()):
        auto = c("2", " (dependency)") if r.get("auto") else ""
        print(f"{c('1', n)} {c('2', r['version'])}{auto}  {r.get('summary', '')}")
    if not state.db:
        print("leaf has installed nothing yet; 'leaf list --base' shows what came with the system")


def cmd_files(args):
    state = State()
    for name in args:
        if name not in state.db:
            die(f"{name} is not installed by leaf")
        print("\n".join(state.db[name]["files"]))


def cmd_owner(args):
    state = State()
    for p in args:
        p = os.path.abspath(p)
        owners = [n for n, r in state.db.items() if p in r["files"]]
        print(f"{p}: {', '.join(owners) if owners else 'not from a leaf package'}")


COMMANDS = {"update": cmd_update, "install": cmd_install, "remove": cmd_remove,
            "upgrade": cmd_upgrade, "search": cmd_search, "show": cmd_show,
            "list": cmd_list, "files": cmd_files, "owner": cmd_owner}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__ if __doc__ else open(__file__).read().split("\n\n")[1])
        print("usage: leaf update | search W.. | show P.. | install P.. | remove P.. | upgrade | list | files P | owner F")
        return
    cmd = COMMANDS.get(sys.argv[1])
    if cmd is None:
        die(f"unknown command '{sys.argv[1]}' (leaf help)")
    try:
        cmd(sys.argv[2:])
    except KeyboardInterrupt:
        die("interrupted")
    except urllib.error.URLError as e:
        die(f"network: {e.reason}")


if __name__ == "__main__":
    main()
