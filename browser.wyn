# WynLang OS Web Browser (Enhanced Version)
# ============================================================
# A fully-featured, gorgeous, Nord-themed web browser
# implemented entirely in interpreted WynLang script.
# Supports back navigation, custom DuckDuckGo search engine,
# interactive homepage with search and quick links, dynamic HTML link
# extraction, key-driven scrolling, and a simulated JS engine.

# Global State
url = "home"
content = ""
scroll_y = 0
search_mode = 0
search_q = ""
focus = 1          # 0 = Top URL bar, 1 = Page Search Box
history_back = "home"

curr_host = ""
curr_port = 80
curr_is_https = 0

# Simulated JS Engine DOM State
js_video_playing = 0
js_video_views = 128
js_video_likes = 14
js_comments_count = 1
js_c1 = "Awesome operating system! Blazing fast!"
js_c2 = "Wait, is this entire browser in script?"
js_c3 = "Can it run Doom? Yes, WASM is supported!"
js_c4 = "Google DeepMind Advanced Agentic team is amazing!"

js_init()

# Clickable link bounds (supports up to 6 active links on screen)
l1_x1 = 0
l1_y1 = 0
l1_x2 = 0
l1_y2 = 0
l1_url = ""

l2_x1 = 0
l2_y1 = 0
l2_x2 = 0
l2_y2 = 0
l2_url = ""

l3_x1 = 0
l3_y1 = 0
l3_x2 = 0
l3_y2 = 0
l3_url = ""

l4_x1 = 0
l4_y1 = 0
l4_x2 = 0
l4_y2 = 0
l4_url = ""

l5_x1 = 0
l5_y1 = 0
l5_x2 = 0
l5_y2 = 0
l5_url = ""

l6_x1 = 0
l6_y1 = 0
l6_x2 = 0
l6_y2 = 0
l6_url = ""

fn clear_links():
    l1_url = ""
    l2_url = ""
    l3_url = ""
    l4_url = ""
    l5_url = ""
    l6_url = ""
end

fn draw_duck_icon(x, y):
    # Head: Nord12 Orange (0xD08770)
    gui_draw_rounded_rect(x, y, 20, 20, 10, 13659226)
    # Cheek: Nord6 White (0xECEFF4)
    gui_draw_rounded_rect(x + 3, y + 3, 5, 5, 2, 15594484)
    # Eye: Nord0 Dark (0x2E3440)
    gui_draw_rect(x + 11, y + 5, 2, 2, 3027776)
    # Beak: Nord13 Yellow (0xEBCB8B)
    gui_draw_rounded_rect(x + 14, y + 8, 9, 5, 2, 15453067)
end

fn on_draw():
    # Get browser window bounds
    wx = gui_get_x()
    wy = gui_get_y()
    ww = gui_get_w()
    wh = gui_get_h()

    # Client area coordinates (leaving space for titlebar)
    cx = wx + 1
    cy = wy + 29
    cw = ww - 2
    ch = wh - 30

    # 1. Draw top panel / address bar area: Nord0 (0x2E3440)
    gui_draw_rect(cx, cy, cw, 32, 3027776)

    # Back button: Nord3 (0x4C566A) background, Nord6 text
    gui_draw_rounded_rect(cx + 8, cy + 6, 22, 20, 4, 4739924)
    gui_draw_text(cx + 15, cy + 8, "<", 15594484)

    # Home button: Nord3 (0x4C566A) background, Nord6 text
    gui_draw_rounded_rect(cx + 34, cy + 6, 22, 20, 4, 4739924)
    gui_draw_text(cx + 41, cy + 8, "H", 15594484)

    # URL input box: Nord1 (0x3B4252) background
    url_box_w = cw - 176
    gui_draw_rounded_rect(cx + 62, cy + 6, url_box_w, 20, 4, 3883602)
    
    # URL border highlight if URL is focused
    if focus == 0:
        gui_draw_rounded_rect_border(cx + 62, cy + 6, url_box_w, 20, 4, 8962256) # Nord8 Blue
    end

    # URL text
    gui_draw_text(cx + 68, cy + 8, url, 15594484)

    # Blinking text edit cursor for URL bar
    if focus == 0:
        url_len = len(url)
        gui_draw_text(cx + 68 + url_len * 9, cy + 8, "|", 8962256)
    end

    # GO button: Nord8 (0x88C0D0) background, Nord0 text
    go_btn_x = cx + cw - 106
    gui_draw_rounded_rect(go_btn_x, cy + 6, 42, 20, 4, 8962256)
    gui_draw_text(go_btn_x + 10, cy + 8, "GO", 3027776)

    # DDG Search button: Nord13 (0xEBCB8B) yellow background, Nord0 text
    ddg_btn_x = cx + cw - 58
    gui_draw_rounded_rect(ddg_btn_x, cy + 6, 50, 20, 4, 15453067)
    gui_draw_text(ddg_btn_x + 9, cy + 8, "DDG", 3027776)

    # Separator line: Nord3 (0x4C566A)
    gui_draw_rect(cx, cy + 32, cw, 1, 4739924)

    # 2. Draw main canvas: Nord6 (0xECEFF4) light background
    rx = cx
    ry = cy + 33
    rw = cw
    rh = ch - 33
    gui_draw_rect(rx, ry, rw, rh, 15594484)

    # 3. Draw content based on active mode
    if url == "ddg:":
        draw_ddg_homepage(rx, ry, rw, rh)
    elif search_mode == 1:
        draw_search_results(rx, ry, rw, rh)
    elif len(content) == 0:
        draw_homepage(rx, ry, rw, rh)
    else:
        draw_html(rx, ry, rw, rh)
    end
end

fn draw_homepage(rx, ry, rw, rh):
    clear_links()

    # Beautiful centered Header shadow & text
    title_x = rx + (rw / 2) - 100
    gui_draw_text(title_x + 1, ry + 26, "WynWeb Portal", 4739924)
    gui_draw_text(title_x, ry + 25, "WynWeb Portal", 8499625) # Nord9 Blue
    
    # Subtitle
    gui_draw_text(rx + (rw / 2) - 145, ry + 50, "The Next-Gen OS Web Experience", 4739924)

    # Large Central Interactive Search Box
    box_w = rw - 80
    box_x = rx + 40
    box_y = ry + 85
    gui_draw_rounded_rect(box_x, box_y, box_w, 28, 6, 15066597) # Nord5 background
    
    if focus == 1:
        gui_draw_rounded_rect_border(box_x, box_y, box_w, 28, 6, 8962256) # Active Nord8 border
    else:
        gui_draw_rounded_rect_border(box_x, box_y, box_w, 28, 6, 14212841) # Nord4 border
    end

    # Search Box Content & Placeholder
    if len(search_q) == 0:
        if focus != 1:
            gui_draw_text(box_x + 12, box_y + 8, "Search with DuckDuckGo or enter URL...", 4739924)
        end
    else:
        gui_draw_text(box_x + 12, box_y + 8, search_q, 3027776)
    end

    # Search Box Cursor
    if focus == 1:
        cursor_pos = len(search_q)
        gui_draw_text(box_x + 12 + cursor_pos * 9, box_y + 8, "|", 8962256)
    end

    # "Search Privately" Button below search box
    btn_w = 140
    btn_x = rx + (rw / 2) - 70
    btn_y = ry + 122
    gui_draw_rounded_rect(btn_x, btn_y, btn_w, 22, 4, 13659226) # Nord12 Orange
    gui_draw_text(btn_x + 10, btn_y + 5, "Search Privately", 15594484) # White text

    # Set Search button Click Bounds
    l5_x1 = btn_x
    l5_y1 = btn_y
    l5_x2 = btn_x + btn_w
    l5_y2 = btn_y + 22
    l5_url = "submit_search"

    # Grid of Quick Link Cards (2x2 grid)
    card_w = 215
    card_h = 42
    
    c1_x = rx + 35
    c1_y = ry + 165
    c2_x = rx + 270
    c2_y = ry + 165
    
    c3_x = rx + 35
    c3_y = ry + 215
    c4_x = rx + 270
    c4_y = ry + 215

    # Card 1: DuckDuckGo (Orange)
    gui_draw_rounded_rect(c1_x, c1_y, card_w, card_h, 6, 15066597)
    gui_draw_rounded_rect_border(c1_x, c1_y, card_w, card_h, 6, 13659226)
    draw_duck_icon(c1_x + 8, c1_y + 11)
    gui_draw_text(c1_x + 36, c1_y + 6, "DuckDuckGo", 13659226)
    gui_draw_text(c1_x + 36, c1_y + 22, "Search privately", 4739924)
    l1_x1 = c1_x
    l1_y1 = c1_y
    l1_x2 = c1_x + card_w
    l1_y2 = c1_y + card_h
    l1_url = "ddg:"

    # Card 2: Host Local Web Server (Green)
    gui_draw_rounded_rect(c2_x, c2_y, card_w, card_h, 6, 15066597)
    gui_draw_rounded_rect_border(c2_x, c2_y, card_w, card_h, 6, 10731148)
    gui_draw_rounded_rect(c2_x + 8, c2_y + 11, 20, 20, 4, 10731148)
    gui_draw_text(c2_x + 14, c2_y + 14, "W", 15594484)
    gui_draw_text(c2_x + 36, c2_y + 6, "Local Web Server", 10731148)
    gui_draw_text(c2_x + 36, c2_y + 22, "Gateway http server", 4739924)
    l2_x1 = c2_x
    l2_y1 = c2_y
    l2_x2 = c2_x + card_w
    l2_y2 = c2_y + card_h
    l2_url = "10.0.2.2:8000"

    # Card 3: WynTube (Red)
    gui_draw_rounded_rect(c3_x, c3_y, card_w, card_h, 6, 15066597)
    gui_draw_rounded_rect_border(c3_x, c3_y, card_w, card_h, 6, 12542314)
    gui_draw_rounded_rect(c3_x + 8, c3_y + 11, 20, 20, 4, 12542314) # Red badge
    gui_draw_text(c3_x + 14, c3_y + 14, "Y", 15594484)
    gui_draw_text(c3_x + 36, c3_y + 6, "WynTube Video", 12542314)
    gui_draw_text(c3_x + 36, c3_y + 22, "Simulated video player", 4739924)
    l3_x1 = c3_x
    l3_y1 = c3_y
    l3_x2 = c3_x + card_w
    l3_y2 = c3_y + card_h
    l3_url = "http://127.0.0.1/youtube.html"

    # Card 4: Kernel Architecture (Blue)
    gui_draw_rounded_rect(c4_x, c4_y, card_w, card_h, 6, 15066597)
    gui_draw_rounded_rect_border(c4_x, c4_y, card_w, card_h, 6, 8499625)
    gui_draw_rounded_rect(c4_x + 8, c4_y + 11, 20, 20, 4, 8499625)
    gui_draw_text(c4_x + 14, c4_y + 14, "K", 15594484)
    gui_draw_text(c4_x + 36, c4_y + 6, "Kernel Architecture", 8499625)
    gui_draw_text(c4_x + 36, c4_y + 22, "System documentation", 4739924)
    l4_x1 = c4_x
    l4_y1 = c4_y
    l4_x2 = c4_x + card_w
    l4_y2 = c4_y + card_h
    l4_url = "http://127.0.0.1/kernel.html"

    # Status Bar
    status_y = ry + rh - 20
    gui_draw_rect(rx, status_y, rw, 20, 14212841)
    gui_draw_text(rx + 15, status_y + 4, "Status: Ready | Engine: WynLang v2.1", 4739924)
end

fn draw_ddg_homepage(rx, ry, rw, rh):
    clear_links()

    # Large Center DuckLogo
    logo_x = rx + (rw / 2) - 10
    logo_y = ry + 40
    gui_draw_rounded_rect(logo_x - 15, logo_y, 40, 40, 20, 13659226)
    gui_draw_rounded_rect(logo_x - 9, logo_y + 6, 10, 10, 4, 15594484)
    gui_draw_rect(logo_x + 6, logo_y + 10, 4, 4, 3027776)
    gui_draw_rounded_rect(logo_x + 12, logo_y + 16, 18, 10, 4, 15453067)

    # Brand Title
    gui_draw_text(rx + (rw / 2) - 50, logo_y + 50, "DuckDuckGo", 13659226)
    gui_draw_text(rx + (rw / 2) - 110, logo_y + 70, "The search engine that doesn't track you.", 4739924)

    # Search Box
    box_w = rw - 100
    box_x = rx + 50
    box_y = logo_y + 100
    gui_draw_rounded_rect(box_x, box_y, box_w, 28, 6, 15066597)
    
    if focus == 1:
        gui_draw_rounded_rect_border(box_x, box_y, box_w, 28, 6, 8962256)
    else:
        gui_draw_rounded_rect_border(box_x, box_y, box_w, 28, 6, 14212841)
    end

    if len(search_q) == 0:
        if focus != 1:
            gui_draw_text(box_x + 12, box_y + 8, "Search privately...", 4739924)
        end
    else:
        gui_draw_text(box_x + 12, box_y + 8, search_q, 3027776)
    end

    if focus == 1:
        cursor_pos = len(search_q)
        gui_draw_text(box_x + 12 + cursor_pos * 9, box_y + 8, "|", 8962256)
    end

    # Submit buttons
    btn_w = 110
    btn_x = rx + (rw / 2) - 120
    btn_y = box_y + 40
    gui_draw_rounded_rect(btn_x, btn_y, btn_w, 22, 4, 13659226)
    gui_draw_text(btn_x + 8, btn_y + 5, "Search Web", 15594484)
    l1_x1 = btn_x
    l1_y1 = btn_y
    l1_x2 = btn_x + btn_w
    l1_y2 = btn_y + 22
    l1_url = "submit_search"

    lucky_x = rx + (rw / 2) + 10
    gui_draw_rounded_rect(lucky_x, btn_y, btn_w, 22, 4, 8499625)
    gui_draw_text(lucky_x + 8, btn_y + 5, "Lucky Demo", 15594484)
    l2_x1 = lucky_x
    l2_y1 = btn_y
    l2_x2 = lucky_x + btn_w
    l2_y2 = btn_y + 22
    l2_url = "hello.wyn"
end

fn draw_search_results(rx, ry, rw, rh):
    clear_links()

    # 1. Search Results Header Bar (glassmorphic light grey)
    hdr_h = 32
    gui_draw_rect(rx, ry, rw, hdr_h, 15066597)
    gui_draw_rect(rx, ry + hdr_h, rw, 1, 14212841)

    draw_duck_icon(rx + 8, ry + 6)
    gui_draw_text(rx + 34, ry + 9, "DuckDuckGo", 13659226)

    # Mini Search Input Box
    sbox_x = rx + 140
    sbox_y = ry + 6
    sbox_w = 210
    sbox_h = 20
    gui_draw_rounded_rect(sbox_x, sbox_y, sbox_w, sbox_h, 4, 15594484)
    
    if focus == 1:
        gui_draw_rounded_rect_border(sbox_x, sbox_y, sbox_w, sbox_h, 4, 8962256)
    else:
        gui_draw_rounded_rect_border(sbox_x, sbox_y, sbox_w, sbox_h, 4, 14212841)
    end
    
    gui_draw_text(sbox_x + 6, sbox_y + 3, search_q, 3027776)
    if focus == 1:
        cursor_pos = len(search_q)
        gui_draw_text(sbox_x + 6 + cursor_pos * 9, sbox_y + 3, "|", 8962256)
    end

    # Search box click bound
    l5_x1 = sbox_x
    l5_y1 = sbox_y
    l5_x2 = sbox_x + sbox_w
    l5_y2 = sbox_y + sbox_h
    l5_url = "focus_search"

    # Search submit button in mini header
    sbtn_x = rx + 360
    gui_draw_rounded_rect(sbtn_x, sbox_y, 56, sbox_h, 4, 13659226)
    gui_draw_text(sbtn_x + 6, sbox_y + 3, "Search", 15594484)
    l6_x1 = sbtn_x
    l6_y1 = sbox_y
    l6_x2 = sbtn_x + 56
    l6_y2 = sbox_y + sbox_h
    l6_url = "submit_search"

    # Back to Home button
    hbtn_x = rx + 424
    gui_draw_rounded_rect(hbtn_x, sbox_y, 48, sbox_h, 4, 4739924)
    gui_draw_text(hbtn_x + 8, sbox_y + 3, "Home", 15594484)
    l3_x1 = hbtn_x
    l3_y1 = sbox_y
    l3_x2 = hbtn_x + 48
    l3_y2 = sbox_y + sbox_h
    l3_url = "home"

    # 2. Render Search Results list with scroll offset
    res_start_y = ry + hdr_h + 12 - scroll_y

    is_kernel = 0
    is_wlang = 0
    is_net = 0

    p_kern = str_find(search_q, "kern")
    p_sys = str_find(search_q, "sys")
    p_os = str_find(search_q, "os")
    if p_kern >= 0 or p_sys >= 0 or p_os >= 0:
        is_kernel = 1
    end

    p_wyn = str_find(search_q, "wyn")
    p_lang = str_find(search_q, "lang")
    p_code = str_find(search_q, "code")
    if p_wyn >= 0 or p_lang >= 0 or p_code >= 0:
        is_wlang = 1
    end

    p_net = str_find(search_q, "net")
    p_dhcp = str_find(search_q, "dhcp")
    p_ip = str_find(search_q, "ip")
    if p_net >= 0 or p_dhcp >= 0 or p_ip >= 0:
        is_net = 1
    end

    item_y = res_start_y

    if is_kernel == 1:
        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 1, "WynlandOS Kernel & Architecture", "http://127.0.0.1/kernel.html", "Learn about multitasking, cooperative scheduler, interrupts, and page faults.")
        item_y = item_y + 64

        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 2, "Physical Memory Manager (PMM)", "http://127.0.0.1/pmm.html", "Details on physical frame allocations, kernel heap, and BIOS maps.")
        item_y = item_y + 64

        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 4, "Virtual File System (VFS)", "http://127.0.0.1/vfs.html", "FAT32 partition layout and abstractions for files, reads, and writes.")
        
    elif is_wlang == 1:
        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 1, "WynLang Interpreter Specification", "http://127.0.0.1/wynlang.html", "Standard syntax guides, functions, recursive limitations, and stack specs.")
        item_y = item_y + 64

        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 2, "Factorial Script Demo (hello.wyn)", "hello.wyn", "Execute WynLang factorial calculator and file listings natively in OS shell.")
        item_y = item_y + 64

        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 4, "Window Manager Bindings", "http://127.0.0.1/wm_bindings.html", "Hook WynLang event handlers: on_draw, on_key, and on_mouse dynamically.")

    elif is_net == 1:
        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 1, "Virtio-Net Driver Implementation", "http://127.0.0.1/virtio_net.html", "PCI driver discovery, ring descriptor negotiation, and memory buffers.")
        item_y = item_y + 64

        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 2, "WynlandOS Network Stack", "http://127.0.0.1/net_stack.html", "Network protocol implementations: ARP, IPv4, DHCP, DNS, and UDP sending.")
        item_y = item_y + 64

        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 4, "Local Network Gateway Host", "10.0.2.2:8000", "Connect to the host development system gateway http server port 8000.")

    else:
        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 1, "DuckDuckGo Search Results: " + search_q, "http://10.0.2.2:8000/", "Attempt to contact the local HTTP server gateway for query results.")
        item_y = item_y + 64

        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 2, "WynlandOS System Guide", "http://127.0.0.1/wynlang.html", "Comprehensive handbook for developers building apps for WynlandOS.")
        item_y = item_y + 64

        draw_result_item(rx + 20, item_y, ry + hdr_h, ry + rh, 4, "Return to Homepage", "home", "Return to the main WynWeb browser start portal and links directory.")
    end
end

fn draw_result_item(x, y, view_top, view_bottom, link_num, title, dest_url, desc):
    if y >= view_top and y + 48 <= view_bottom:
        # Title (Nord10 Blue)
        gui_draw_text(x, y, title, 6193580)
        
        # URL (Nord14 Green)
        gui_draw_text(x, y + 16, dest_url, 10731148)
        
        # Description (Nord3 Dark Grey)
        gui_draw_text(x, y + 32, str_slice(desc, 0, 56), 4739924)

        # Set Link Bounds
        if link_num == 1:
            l1_x1 = x
            l1_y1 = y
            l1_x2 = x + 350
            l1_y2 = y + 15
            l1_url = dest_url
        elif link_num == 2:
            l2_x1 = x
            l2_y1 = y
            l2_x2 = x + 350
            l2_y2 = y + 15
            l2_url = dest_url
        elif link_num == 4:
            l4_x1 = x
            l4_y1 = y
            l4_x2 = x + 350
            l4_y2 = y + 15
            l4_url = dest_url
        end
    end
end

fn draw_html(rx, ry, rw, rh):
    curr_x = rx + 15
    curr_y = ry + 15 - scroll_y
    is_h1 = false
    is_h2 = false
    is_link = false
    link_url = ""

    pos = 0
    html_len = len(content)

    clear_links()
    links_count = 0

    while pos < html_len:
        ch = str_slice(content, pos, 1)
        if ch == "<":
            rest = str_slice(content, pos, html_len - pos)
            tag_end = str_find(rest, ">")
            if tag_end > 0:
                tag = str_slice(rest, 1, tag_end - 1)
                pos = pos + tag_end + 1

                # Parse tag
                p_href = str_find(tag, "href=\"")
                
                if tag == "h1":
                    is_h1 = true
                elif tag == "/h1":
                    is_h1 = false
                    curr_x = rx + 15
                    curr_y = curr_y + 24
                elif tag == "h2":
                    is_h2 = true
                elif tag == "/h2":
                    is_h2 = false
                    curr_x = rx + 15
                    curr_y = curr_y + 20
                elif tag == "p":
                    curr_x = rx + 15
                    curr_y = curr_y + 20
                elif tag == "br":
                    curr_x = rx + 15
                    curr_y = curr_y + 18
                elif p_href >= 0:
                    links_count = links_count + 1
                    u_start = p_href + 6
                    u_rest = str_slice(tag, u_start, len(tag) - u_start)
                    p_quote = str_find(u_rest, "\"")
                    if p_quote >= 0:
                        link_url = str_slice(u_rest, 0, p_quote)
                        if links_count == 1:
                            l1_url = link_url
                            l1_x1 = curr_x
                            l1_y1 = curr_y
                        elif links_count == 2:
                            l2_url = link_url
                            l2_x1 = curr_x
                            l2_y1 = curr_y
                        elif links_count == 3:
                            l3_url = link_url
                            l3_x1 = curr_x
                            l3_y1 = curr_y
                        elif links_count == 4:
                            l4_url = link_url
                            l4_x1 = curr_x
                            l4_y1 = curr_y
                        elif links_count == 5:
                            l5_url = link_url
                            l5_x1 = curr_x
                            l5_y1 = curr_y
                        elif links_count == 6:
                            l6_url = link_url
                            l6_x1 = curr_x
                            l6_y1 = curr_y
                        end
                    end
                    is_link = true
                elif tag == "/a":
                    if links_count == 1:
                        l1_x2 = curr_x
                        l1_y2 = curr_y + 14
                    elif links_count == 2:
                        l2_x2 = curr_x
                        l2_y2 = curr_y + 14
                    elif links_count == 3:
                        l3_x2 = curr_x
                        l3_y2 = curr_y + 14
                    elif links_count == 4:
                        l4_x2 = curr_x
                        l4_y2 = curr_y + 14
                    elif links_count == 5:
                        l5_x2 = curr_x
                        l5_y2 = curr_y + 14
                    elif links_count == 6:
                        l6_x2 = curr_x
                        l6_y2 = curr_y + 14
                    end
                    is_link = false
                end
            else:
                pos = pos + 1
            end
        else:
            if ch == "\n":
                curr_x = rx + 15
                curr_y = curr_y + 18
            else:
                # Text wrap
                if curr_x + 9 > rx + rw - 15:
                    curr_x = rx + 15
                    curr_y = curr_y + 18
                end

                if curr_y >= ry and curr_y + 16 <= ry + rh:
                    color = 3027776
                    if is_h1:
                        color = 8499625
                    elif is_h2:
                        color = 8962256
                    elif is_link:
                        color = 6193580
                    end

                    gui_draw_char(curr_x, curr_y, ch, color)
                end

                curr_x = curr_x + 9
            end
            pos = pos + 1
        end
    end
end

fn on_key(scancode, ascii):
    if scancode == 14:
        # Backspace
        if focus == 0:
            if url == "home":
                url = ""
                gui_mark_dirty()
            elif url == "ddg:":
                url = ""
                gui_mark_dirty()
            else:
                url_len = len(url)
                if url_len > 0:
                    url = str_slice(url, 0, url_len - 1)
                    gui_mark_dirty()
                end
            end
        elif focus == 1:
            q_len = len(search_q)
            if q_len > 0:
                search_q = str_slice(search_q, 0, q_len - 1)
                gui_mark_dirty()
            end
        end
    elif scancode == 15:
        # Tab key: toggle focus between URL bar and Search Box
        focus = 1 - focus
        gui_mark_dirty()
    elif scancode == 28:
        # Enter key
        if focus == 0:
            load_url()
        elif focus == 1:
            submit_search()
        end
    elif scancode == 72:
        # Up Arrow
        if len(content) > 0 or search_mode == 1:
            scroll_y = scroll_y - 24
            if scroll_y < 0:
                scroll_y = 0
            end
            gui_mark_dirty()
        end
    elif scancode == 80:
        # Down Arrow
        if len(content) > 0 or search_mode == 1:
            scroll_y = scroll_y + 24
            gui_mark_dirty()
        end
    elif scancode == 73:
        # Page Up: fast scroll
        if len(content) > 0 or search_mode == 1:
            scroll_y = scroll_y - 120
            if scroll_y < 0:
                scroll_y = 0
            end
            gui_mark_dirty()
        end
    elif scancode == 81:
        # Page Down: fast scroll
        if len(content) > 0 or search_mode == 1:
            scroll_y = scroll_y + 120
            gui_mark_dirty()
        end
    else:
        if len(ascii) > 0:
            if focus == 0:
                if url == "home":
                    url = ""
                elif url == "ddg:":
                    url = ""
                end
                
                p_ddg = str_find(url, "ddg:?q=")
                if p_ddg == 0:
                    url = ""
                end
                
                url = url + ascii
                gui_mark_dirty()
            elif focus == 1:
                search_q = search_q + ascii
                gui_mark_dirty()
            end
        end
    end
end

fn on_mouse(mx, my, buttons):
    if buttons == 1:
        wx = gui_get_x()
        wy = gui_get_y()
        ww = gui_get_w()
        wh = gui_get_h()

        cx = wx + 1
        cy = wy + 29
        cw = ww - 2
        ch = wh - 30

        rx = cx
        ry = cy + 33
        rw = cw
        rh = ch - 33

        # 1. Check top panel clicks
        # Back button
        if mx >= cx + 8 and mx <= cx + 30 and my >= cy + 6 and my <= cy + 26:
            url = history_back
            load_url()
            return
        end

        # Home button
        if mx >= cx + 34 and mx <= cx + 56 and my >= cy + 6 and my <= cy + 26:
            url = "home"
            load_url()
            return
        end

        # URL Input Box
        url_w = cw - 176
        if mx >= cx + 62 and mx <= cx + 62 + url_w and my >= cy + 6 and my <= cy + 26:
            focus = 0
            gui_mark_dirty()
            return
        end

        # GO button
        go_x = cx + cw - 106
        if mx >= go_x and mx <= go_x + 42 and my >= cy + 6 and my <= cy + 26:
            load_url()
            return
        end

        # DDG button
        ddg_x = cx + cw - 58
        if mx >= ddg_x and mx <= ddg_x + 50 and my >= cy + 6 and my <= cy + 26:
            if len(url) > 0 and url != "home" and url != "ddg:":
                search_q = url
            end
            url = "ddg:"
            focus = 1
            load_url()
            return
        end

        # 2. Check main canvas clicks
        if url == "ddg:":
            box_x = rx + 50
            box_y = ry + 140
            box_w = rw - 100
            if mx >= box_x and mx <= box_x + box_w and my >= box_y and my <= box_y + 28:
                focus = 1
                gui_mark_dirty()
                return
            end
        elif len(content) == 0 and search_mode == 0:
            box_x = rx + 40
            box_y = ry + 85
            box_w = rw - 80
            if mx >= box_x and mx <= box_x + box_w and my >= box_y and my <= box_y + 28:
                focus = 1
                gui_mark_dirty()
                return
            end
        end

        # General links checks
        if len(l1_url) > 0:
            if mx >= l1_x1 and mx <= l1_x2 and my >= l1_y1 and my <= l1_y2:
                handle_link_click(l1_url)
                return
            end
        end
        if len(l2_url) > 0:
            if mx >= l2_x1 and mx <= l2_x2 and my >= l2_y1 and my <= l2_y2:
                handle_link_click(l2_url)
                return
            end
        end
        if len(l3_url) > 0:
            if mx >= l3_x1 and mx <= l3_x2 and my >= l3_y1 and my <= l3_y2:
                handle_link_click(l3_url)
                return
            end
        end
        if len(l4_url) > 0:
            if mx >= l4_x1 and mx <= l4_x2 and my >= l4_y1 and my <= l4_y2:
                handle_link_click(l4_url)
                return
            end
        end
        if len(l5_url) > 0:
            if mx >= l5_x1 and mx <= l5_x2 and my >= l5_y1 and my <= l5_y2:
                handle_link_click(l5_url)
                return
            end
        end
        if len(l6_url) > 0:
            if mx >= l6_x1 and mx <= l6_x2 and my >= l6_y1 and my <= l6_y2:
                handle_link_click(l6_url)
                return
            end
        end
    end
end

fn handle_link_click(dest):
    if dest == "submit_search":
        submit_search()
    elif dest == "focus_search":
        focus = 1
        gui_mark_dirty()
    else:
        p_js = str_find(dest, "javascript:")
        if p_js == 0:
            js_code = str_slice(dest, 11, len(dest) - 11)
            run_js(js_code)
        else:
            p_http = str_find(dest, "http://")
            p_https = str_find(dest, "https://")
            if p_http < 0 and p_https < 0 and dest != "home" and dest != "ddg:" and dest != "hello.wyn":
                p_slash_slash = str_find(dest, "//")
                if p_slash_slash == 0:
                    url = "https:" + dest
                else:
                    proto = "http://"
                    if curr_is_https == 1:
                        proto = "https://"
                    end
                    port_suffix = ""
                    if curr_port != 80 and curr_port != 443:
                        port_suffix = ":" + str(curr_port)
                    end
                    p_slash_first = str_find(dest, "/")
                    if p_slash_first == 0:
                        url = proto + curr_host + port_suffix + dest
                    else:
                        url = proto + curr_host + port_suffix + "/" + dest
                    end
                end
            else:
                url = dest
            end
            load_url()
        end
    end
end

fn run_js(js_code):
    print("JS Engine executing: " + js_code)
    res = js_eval(js_code)
    print("JS Engine result: " + res)
    load_url()
end

fn submit_search():
    search_mode = 0
    scroll_y = 0
    focus = 0
    
    # Replace spaces with '+' for search URL
    search_term = ""
    pos_space = 0
    while pos_space < len(search_q):
        ch_space = str_slice(search_q, pos_space, 1)
        if ch_space == " ":
            search_term = search_term + "+"
        else:
            search_term = search_term + ch_space
        end
        pos_space = pos_space + 1
    end
    
    url = "https://html.duckduckgo.com/html/?q=" + search_term
    load_url()
end

fn load_url():
    js_video_playing = js_get_state("video_playing")
    js_video_views = js_get_state("video_views")
    js_video_likes = js_get_state("video_likes")
    js_comments_count = js_get_state("comments_count")

    if url != "submit_search" and url != "focus_search":
        if url != "home" and url != "ddg:":
            history_back = "home"
        end
    end

    search_mode = 0
    scroll_y = 0

    is_search = 1
    p_dot = str_find(url, ".")
    p_colon = str_find(url, ":")
    p_slash = str_find(url, "/")
    if p_dot >= 0 or p_colon >= 0 or p_slash >= 0:
        is_search = 0
    end
    if url == "home" or url == "ddg:" or url == "hello.wyn":
        is_search = 0
    end

    p_ddg_q = str_find(url, "ddg:?q=")
    if p_ddg_q >= 0:
        search_mode = 1
        search_q = str_slice(url, 7, len(url) - 7)
        gui_mark_dirty()
        return
    end

    if is_search == 1:
        search_q = url
        submit_search()
        return
    end

    p_google = str_find(url, "google")
    p_wiki = str_find(url, "wikipedia")
    p_git = str_find(url, "github")
    p_yt = str_find(url, "youtube")

    if url == "home":
        content = ""
        focus = 1
        gui_mark_dirty()
    elif url == "ddg:":
        content = ""
        focus = 1
        gui_mark_dirty()
    elif p_google >= 0:
        content = "<html><h1>Google</h1><p>Search the World's Information.</p><br><p>Search privately with DuckDuckGo:</p><p>* <a href=\"ddg:\">[ Go to DuckDuckGo ]</a></p><br><p><a href=\"home\">Back to Homepage</a></p></html>"
        gui_mark_dirty()
    elif p_wiki >= 0:
        content = "<html><h1>Wikipedia</h1><p>The Free Encyclopedia.</p><br><h2>Featured Article: WynlandOS</h2><p>WynlandOS is a modern, x86_64 microkernel operating system built for educational pair programming.</p><br><h2>Popular Articles:</h2><p>* <a href=\"http://127.0.0.1/kernel.html\">Kernel Design</a></p><p>* <a href=\"http://127.0.0.1/wynlang.html\">WynLang Interpreter</a></p><p>* <a href=\"http://127.0.0.1/virtio_net.html\">Virtio Network Driver</a></p><br><p><a href=\"home\">Back to Homepage</a></p></html>"
        gui_mark_dirty()
    elif p_git >= 0:
        content = "<html><h1>GitHub</h1><p>Where the world builds software.</p><br><h2>Repository: WynlandOS/kernel</h2><p><b>Branches:</b> main | dev</p><p><b>Files:</b></p><p>* <a href=\"http://127.0.0.1/kernel.html\">kernel/main.c</a> - Boot and init code</p><p>* <a href=\"http://127.0.0.1/wynlang.html\">lib/wlang.c</a> - WynLang interpreter source</p><p>* <a href=\"hello.wyn\">hello.wyn</a> - Factorial and system demo script</p><br><p><a href=\"home\">Back to Homepage</a></p></html>"
        gui_mark_dirty()
    elif url == "http://127.0.0.1/youtube.html":
        player_text = "Playing: [||||||||||||]"
        if js_video_playing == 0:
            player_text = "Paused:  [            ]"
        end
        
        content = "<html><h1>WynTube Video Player</h1>"
        content = content + "<p><b>Video: Building WynlandOS Kernel from Scratch</b></p>"
        content = content + "<p>" + player_text + " 1:24 / 5:00</p>"
        content = content + "<p><a href=\"javascript:playVideo()\">[ PLAY / PAUSE ]</a></p>"
        content = content + "<p>Views: " + str(js_video_views) + " | Likes: " + str(js_video_likes) + "</p>"
        content = content + "<p><a href=\"javascript:likeVideo()\">[ LIKE VIDEO ]</a></p>"
        content = content + "<br><h2>Comments:</h2>"
        
        if js_comments_count >= 1:
            content = content + "<p>* User1: " + js_c1 + "</p>"
        end
        if js_comments_count >= 2:
            content = content + "<p>* DevGuest: " + js_c2 + "</p>"
        end
        if js_comments_count >= 3:
            content = content + "<p>* HackerNews: " + js_c3 + "</p>"
        end
        if js_comments_count >= 4:
            content = content + "<p>* GoogleMind: " + js_c4 + "</p>"
        end
        
        content = content + "<br><p><a href=\"javascript:addComment()\">[ WRITE MOCK COMMENT ]</a></p>"
        content = content + "<br><p><a href=\"home\">Back to Homepage</a></p></html>"
        gui_mark_dirty()
    elif p_yt >= 0:
        content = "<html><h1>WynTube Video Sharing</h1><p>Share and watch videos.</p><br><h2>Trending Videos:</h2><p>* <a href=\"http://127.0.0.1/youtube.html\">Building a 64-bit OS Kernel from scratch</a> (5 mins)</p><p>* <a href=\"http://127.0.0.1/wynlang.html\">WynLang: Writing Python inside a Kernel!</a> (12 mins)</p><p>* <a href=\"http://127.0.0.1/virtio_net.html\">Virtio Network Driver walkthrough</a> (8 mins)</p><br><p><a href=\"home\">Back to Homepage</a></p></html>"
        gui_mark_dirty()
    elif url == "http://127.0.0.1/kernel.html":
        content = "<html><h1>WynlandOS Kernel</h1><p>The kernel runs in 64-bit Long Mode with hardware paging enabled.</p><p>It features a multitasking cooperative scheduler and critical spinlocks.</p><p>Built by Google DeepMind Advanced Agentic Coding team.</p><br><h2>System Docs</h2><p>* <a href=\"http://127.0.0.1/pmm.html\">Physical Memory Manager</a></p><p>* <a href=\"http://127.0.0.1/vfs.html\">Virtual File System</a></p><p>* <a href=\"home\">Go back home</a></p></html>"
        gui_mark_dirty()
    elif url == "http://127.0.0.1/pmm.html":
        content = "<html><h1>Physical Memory Manager</h1><p>The PMM maps physical frames and bios memory layouts.</p><p>It manages physical memory allocation via a bitmap starting at 1MB.</p><br><p><a href=\"http://127.0.0.1/kernel.html\">Back to Kernel docs</a></p></html>"
        gui_mark_dirty()
    elif url == "http://127.0.0.1/wynlang.html":
        content = "<html><h1>WynLang Guide</h1><p>WynLang is a Python-inspired interpreted language inside WynlandOS.</p><p>It features a tree-walk interpreter, dynamic types, and network/drawing bindings.</p><br><h2>Drawing APIs:</h2><p>* gui_draw_rect - Draw filled rect</p><p>* gui_draw_text - Render text string</p><p>* gui_draw_rounded_rect - Draw rounded box</p><br><p><a href=\"hello.wyn\">Run hello.wyn demo script</a></p><p><a href=\"http://127.0.0.1/wm_bindings.html\">View WM Bindings docs</a></p></html>"
        gui_mark_dirty()
    elif url == "http://127.0.0.1/vfs.html":
        content = "<html><h1>Virtual File System</h1><p>The VFS abstracts filesystem operations for the FAT32 disk image.</p><p>It supports reading, writing, and directory listings.</p><br><p><a href=\"home\">Back to Homepage</a></p></html>"
        gui_mark_dirty()
    elif url == "http://127.0.0.1/wm_bindings.html":
        content = "<html><h1>Window Manager Bindings</h1><p>The desktop environment hooks WynLang to standard event callbacks:</p><p><b>on_draw():</b> Triggered when window content is redrawn.</p><p><b>on_key(scancode, ascii):</b> Triggered on key press events.</p><p><b>on_mouse(mx, my, buttons):</b> Triggered on mouse click/interaction.</p><br><p><a href=\"home\">Back to Homepage</a></p></html>"
        gui_mark_dirty()
    elif url == "http://127.0.0.1/virtio_net.html":
        content = "<html><h1>Virtio-Net Driver</h1><p>The low-level network driver registers with the PCI bus (0x1AF4:0x1000).</p><p>It negotiates ring structures and issues Virtqueue notifications.</p><br><p><a href=\"http://127.0.0.1/net_stack.html\">Read about the Network Stack</a></p></html>"
        gui_mark_dirty()
    elif url == "http://127.0.0.1/net_stack.html":
        content = "<html><h1>Network Stack</h1><p>The stack parses Ethernet, ARP, IPv4, ICMP (ping), UDP, DHCP, and DNS.</p><p>It resolves DNS queries via standard DNS requests.</p><br><p><a href=\"home\">Back to Homepage</a></p></html>"
        gui_mark_dirty()
    elif url == "hello.wyn":
        content = read("/hello.wyn")
        gui_mark_dirty()
    else:
        # Check if URL starts with http/https
        p_http = str_find(url, "http://")
        p_https = str_find(url, "https://")
        
        is_https = 0
        rest = url
        
        if p_https >= 0:
            rest = str_slice(url, 8, len(url) - 8)
            is_https = 1
        elif p_http >= 0:
            rest = str_slice(url, 7, len(url) - 7)
        else:
            # Check if it contains a dot, meaning it's a domain
            p_dot = str_find(url, ".")
            if p_dot >= 0:
                url = "https://" + url
                rest = url
                is_https = 1
            else:
                # Treat as search term
                search_term = ""
                pos_space = 0
                while pos_space < len(url):
                    ch_space = str_slice(url, pos_space, 1)
                    if ch_space == " ":
                        search_term = search_term + "+"
                    else:
                        search_term = search_term + ch_space
                    end
                    pos_space = pos_space + 1
                end
                
                url = "https://html.duckduckgo.com/html/?q=" + search_term
                rest = str_slice(url, 8, len(url) - 8)
                is_https = 1
            end
        end

        p_slash = str_find(rest, "/")
        if p_slash >= 0:
            host_part = str_slice(rest, 0, p_slash)
            path = str_slice(rest, p_slash, len(rest) - p_slash)
        else:
            host_part = rest
            path = "/"
        end

        p_colon = str_find(host_part, ":")
        if p_colon >= 0:
            host = str_slice(host_part, 0, p_colon)
            port_str = str_slice(host_part, p_colon + 1, len(host_part) - p_colon - 1)
            port = int(port_str)
        else:
            host = host_part
            if is_https == 1:
                port = 443
            else:
                port = 80
            end
        end

        curr_host = host
        curr_port = port
        curr_is_https = is_https
        print("Browser: HTTP GET host=" + host + " path=" + path + " https=" + str(is_https))
        
        if is_https == 1:
            content = https_get(host, port, path)
        else:
            content = http_get(host, port, path)
        end
        
        if len(content) == 0:
            content = "<html><h1>Offline Mode / Connect Error</h1><p>Could not connect to " + host + ":" + str(port) + "</p><p>Check if the local web server or transparent proxy is running on the host system.</p><br><p><a href=\"home\">Return to Homepage</a></p></html>"
        end
        gui_mark_dirty()
    end
end
